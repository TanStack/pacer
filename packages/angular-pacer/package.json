{
  "name": "@tanstack/angular-pacer",
  "version": "0.27.0",
  "description": "Utilities for debouncing and throttling functions in Angular.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/pacer.git",
    "directory": "packages/angular-pacer"
  },
  "homepage": "https://tanstack.com/pacer",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "angular",
    "debounce",
    "throttle",
    "rate-limit",
    "queue",
    "async",
    "signals"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint": "oxlint ./src ./tests",
    "lint:fix": "oxlint ./src ./tests --fix",
    "test:oxlint": "oxlint ./src ./tests",
    "test:lib": "vitest run",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./async-batcher": "./dist/async-batcher/index.js",
    "./async-debouncer": "./dist/async-debouncer/index.js",
    "./async-queuer": "./dist/async-queuer/index.js",
    "./async-rate-limiter": "./dist/async-rate-limiter/index.js",
    "./async-retryer": "./dist/async-retryer/index.js",
    "./async-throttler": "./dist/async-throttler/index.js",
    "./batcher": "./dist/batcher/index.js",
    "./debouncer": "./dist/debouncer/index.js",
    "./provider": "./dist/provider/index.js",
    "./queuer": "./dist/queuer/index.js",
    "./rate-limiter": "./dist/rate-limiter/index.js",
    "./throttler": "./dist/throttler/index.js",
    "./types": "./dist/types/index.js",
    "./utils": "./dist/utils/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tanstack/pacer": "workspace:*",
    "@tanstack/store": "^0.11.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/build": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1"
  },
  "peerDependencies": {
    "@angular/core": ">=20.0.0"
  }
}

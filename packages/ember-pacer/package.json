{
  "name": "@tanstack/ember-pacer",
  "version": "0.2.0",
  "description": "Ember adapter for TanStack Pacer",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/pacer.git",
    "directory": "packages/ember-pacer"
  },
  "homepage": "https://tanstack.com/pacer",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "ember",
    "debounce",
    "throttle",
    "rate-limit",
    "queue",
    "async"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint": "oxlint ./src ./tests",
    "lint:fix": "oxlint ./src ./tests --fix",
    "test:oxlint": "oxlint ./src ./tests",
    "test:lib": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "ember-tsc --noEmit",
    "build": "tsdown",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./async-batcher": "./dist/async-batcher/index.js",
    "./async-debouncer": "./dist/async-debouncer/index.js",
    "./async-queuer": "./dist/async-queuer/index.js",
    "./async-rate-limiter": "./dist/async-rate-limiter/index.js",
    "./async-throttler": "./dist/async-throttler/index.js",
    "./batcher": "./dist/batcher/index.js",
    "./debouncer": "./dist/debouncer/index.js",
    "./provider": "./dist/provider/index.js",
    "./queuer": "./dist/queuer/index.js",
    "./rate-limiter": "./dist/rate-limiter/index.js",
    "./throttler": "./dist/throttler/index.js",
    "./types": "./dist/types/index.js",
    "./utils": "./dist/utils/index.js",
    "./package.json": "./package.json",
    "./addon-main.js": "./addon-main.cjs"
  },
  "sideEffects": [
    "./tests/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "addon-main.cjs"
  ],
  "dependencies": {
    "@embroider/addon-shim": "^1.11.0",
    "@tanstack/pacer": "workspace:*",
    "@tanstack/store": "^0.11.2"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/plugin-transform-typescript": "8.0.6",
    "@ember/app-tsconfig": "2.1.0",
    "@ember/test-helpers": "^5.8.0",
    "@embroider/core": "4.6.10",
    "@embroider/macros": "1.21.4",
    "@embroider/vite": "^1.8.0",
    "@glimmer/component": "2.2.1",
    "@glint/ember-tsc": "1.14.3",
    "@glint/template": "1.11.1",
    "@glint/tsserver-plugin": "2.7.16",
    "@rollup/plugin-babel": "7.1.0",
    "@types/qunit": "^2.19.14",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "decorator-transforms": "2.4.0",
    "ember-qunit": "^9.2.0",
    "ember-source": "7.4.0",
    "ember-strict-application-resolver": "0.1.1",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "testem": "^3.21.5",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "ember-source": ">=6.8.0"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs"
  },
  "nx": {
    "targets": {
      "test:lib": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    }
  }
}

{
  "name": "@tanstack/svelte-pacer-devtools",
  "version": "0.1.0",
  "description": "Svelte devtools for TanStack Pacer",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/pacer.git",
    "directory": "packages/svelte-pacer-devtools"
  },
  "homepage": "https://tanstack.com/pacer",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "svelte",
    "tanstack",
    "keys",
    "devtools",
    "pacer"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "svelte-package --input ./src --output ./dist",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "svelte": "./dist/production.js",
      "import": "./dist/production.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "svelte": "^5.25.0"
  },
  "dependencies": {
    "@tanstack/devtools-utils": "^0.7.0",
    "@tanstack/pacer-devtools": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint-plugin-svelte": "^3.23.0",
    "svelte": "^5.57.1"
  },
  "module": "dist/index.js",
  "svelte": "./dist/index.js"
}

{
  "name": "@tanstack/pacer",
  "version": "0.22.0",
  "description": "Utilities for debouncing, throttling, rate-limiting, queuing, and more.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/pacer.git",
    "directory": "packages/pacer"
  },
  "homepage": "https://tanstack.com/pacer",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "debounce",
    "throttle",
    "rate-limit",
    "queuer",
    "queue",
    "pacer"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint:fix": "eslint ./src --fix",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./async-batcher": "./dist/async-batcher.js",
    "./async-debouncer": "./dist/async-debouncer.js",
    "./async-queuer": "./dist/async-queuer.js",
    "./async-rate-limiter": "./dist/async-rate-limiter.js",
    "./async-retryer": "./dist/async-retryer.js",
    "./async-throttler": "./dist/async-throttler.js",
    "./batcher": "./dist/batcher.js",
    "./debouncer": "./dist/debouncer.js",
    "./event-client": "./dist/event-client.js",
    "./queuer": "./dist/queuer.js",
    "./rate-limiter": "./dist/rate-limiter.js",
    "./throttler": "./dist/throttler.js",
    "./types": "./dist/types.js",
    "./utils": "./dist/utils.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/store": "^0.11.1"
  }
}

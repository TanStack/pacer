{
  "name": "@tanstack/preact-pacer",
  "version": "0.24.2",
  "description": "Utilities for debouncing and throttling functions in Preact.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TanStack/pacer.git",
    "directory": "packages/preact-pacer"
  },
  "homepage": "https://tanstack.com/pacer",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "preact",
    "debounce",
    "throttle",
    "rate-limit",
    "queue",
    "async"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./async-batcher": "./dist/async-batcher/index.js",
    "./async-debouncer": "./dist/async-debouncer/index.js",
    "./async-queuer": "./dist/async-queuer/index.js",
    "./async-rate-limiter": "./dist/async-rate-limiter/index.js",
    "./async-retryer": "./dist/async-retryer/index.js",
    "./async-throttler": "./dist/async-throttler/index.js",
    "./batcher": "./dist/batcher/index.js",
    "./debouncer": "./dist/debouncer/index.js",
    "./provider": "./dist/provider/index.js",
    "./queuer": "./dist/queuer/index.js",
    "./rate-limiter": "./dist/rate-limiter/index.js",
    "./throttler": "./dist/throttler/index.js",
    "./types": "./dist/types/index.js",
    "./utils": "./dist/utils/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint:fix": "eslint ./src --fix",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest --passWithNoTests",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts",
    "build": "tsdown"
  },
  "dependencies": {
    "@tanstack/pacer": "workspace:*",
    "@tanstack/preact-store": "^0.13.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "preact": "^11.0.1"
  },
  "peerDependencies": {
    "preact": ">=10.0.0"
  }
}

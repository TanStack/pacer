{
  "name": "@tanstack/pacer-lite",
  "version": "0.3.0",
  "description": "Lightweight utilities for debouncing, throttling, and more - designed for npm packages.",
  "author": "Tanner Linsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/pacer.git",
    "directory": "packages/pacer-lite"
  },
  "homepage": "https://tanstack.com/pacer",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "debounce",
    "throttle",
    "rate-limit",
    "pacer",
    "lightweight",
    "minimal"
  ],
  "scripts": {
    "clean": "premove ./build ./dist",
    "lint:fix": "eslint ./src --fix",
    "test:eslint": "eslint ./src",
    "test:lib": "vitest",
    "test:lib:dev": "pnpm test:lib --watch",
    "test:types": "tsc",
    "build": "tsdown",
    "test:build": "publint --strict && node ../../scripts/verify-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lite-batcher": "./dist/lite-batcher.js",
    "./lite-debouncer": "./dist/lite-debouncer.js",
    "./lite-queuer": "./dist/lite-queuer.js",
    "./lite-rate-limiter": "./dist/lite-rate-limiter.js",
    "./lite-throttler": "./dist/lite-throttler.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@tanstack/pacer": "workspace:*"
  }
}

{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/pacer.git"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.21.0 || >=26.0.0",
    "pnpm": ">=12.6.0"
  },
  "type": "module",
  "scripts": {
    "build": "nx affected --skip-nx-cache --targets=build --exclude=examples/** && size-limit",
    "build:all": "nx run-many --targets=build --exclude=examples/** && size-limit",
    "build:core": "nx run-many --targets=build --projects=packages/pacer,packages/pacer-lite && size-limit",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm format",
    "clean": "find . -name 'dist' -type d -prune -exec rm -rf {} +",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf {} +",
    "clean:all": "pnpm run clean && pnpm run clean:node_modules",
    "copy:readme": "node scripts/copy-readme.ts",
    "dev": "pnpm run watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate-docs": "node scripts/generate-docs.ts && pnpm run copy:readme",
    "lint:fix": "nx affected --target=lint:fix --exclude=examples/**",
    "lint:fix:all": "nx run-many --targets=lint:fix",
    "size": "size-limit",
    "test": "pnpm run test:ci",
    "test:ci": "pnpm run test:projects && nx run-many --targets=test:e2e:types,test:e2e:lint,test:oxlint,test:eslint,test:sherif,test:knip,test:docs,test:lib,test:types,build,test:build && size-limit",
    "test:docs": "node scripts/verify-links.ts",
    "test:eslint": "nx affected --target=test:eslint --exclude=examples/**",
    "test:oxlint": "nx affected --target=test:oxlint --exclude=examples/**",
    "test:knip": "knip",
    "test:lib": "nx affected --targets=test:lib --exclude=examples/**",
    "test:lib:dev": "pnpm test:lib && nx watch --all -- pnpm test:lib",
    "test:pr": "pnpm run test:projects && nx affected --targets=test:e2e:types,test:e2e:lint,test:oxlint,test:eslint,test:sherif,test:knip,test:docs,test:lib,test:types,build,test:build",
    "test:projects": "node scripts/verify-test-projects.ts",
    "test:sherif": "sherif",
    "test:types": "nx affected --targets=test:types --exclude=examples/**",
    "watch": "pnpm run build:all && nx watch --all -- pnpm run build:all",
    "test:e2e": "nx run-many --target=test:e2e --parallel=2",
    "test:e2e:affected": "nx affected --target=test:e2e --parallel=2",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:types": "node scripts/verify-example-e2e.ts && tsc --project tests/e2e/tsconfig.json",
    "test:e2e:lint": "oxlint playwright.config.ts scripts/verify-example-e2e.ts tests/e2e/helpers examples/*/*/tests/e2e"
  },
  "nx": {
    "includedScripts": [
      "test:docs",
      "test:knip",
      "test:sherif",
      "test:e2e:types",
      "test:e2e:lint"
    ]
  },
  "size-limit": [
    {
      "path": "packages/pacer/dist/index.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@tanstack/oxfmt-config": "0.1.0",
    "@tanstack/oxlint-config": "0.2.0",
    "@tanstack/typedoc-config": "0.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.6",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "markdown-link-extractor": "^4.0.4",
    "nx": "^24.0.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "premove": "^4.0.0",
    "publint": "^0.3.25",
    "sherif": "^1.13.0",
    "size-limit": "^14.3.0",
    "svelte": "^5.57.3",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zone.js": "~0.16.3"
  },
  "volta": {
    "node": "24.22.1"
  }
}

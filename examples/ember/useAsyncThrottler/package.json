{
  "name": "@tanstack/pacer-example-ember-use-async-throttler",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3005",
    "build": "vite build",
    "preview": "vite preview",
    "test:types": "ember-tsc --noEmit",
    "test:e2e": "PLAYWRIGHT_TEST_DIR=$PWD/tests/e2e playwright test --config ../../../playwright.config.ts"
  },
  "dependencies": {
    "@embroider/macros": "1.21.4",
    "@embroider/router": "3.0.6",
    "@glimmer/component": "2.2.1",
    "@tanstack/devtools": "^0.16.0",
    "@tanstack/ember-pacer": "workspace:*",
    "@tanstack/pacer-devtools": "workspace:*",
    "decorator-transforms": "2.4.0",
    "ember-source": "7.4.0",
    "ember-strict-application-resolver": "0.1.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/plugin-transform-runtime": "8.1.2",
    "@babel/plugin-transform-typescript": "8.0.6",
    "@babel/runtime": "8.1.2",
    "@ember/app-tsconfig": "2.1.0",
    "@embroider/core": "4.6.10",
    "@glint/ember-tsc": "1.14.3",
    "@glint/template": "1.11.1",
    "@glint/tsserver-plugin": "2.7.16",
    "@nullvoxpopuli/ember-vite": "1.5.0",
    "@rollup/plugin-babel": "7.1.0",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "typescript": "6.0.3",
    "vite": "^8.3.8"
  },
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "ember": {
    "edition": "octane"
  }
}

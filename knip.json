{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@faker-js/faker"],
  "ignoreWorkspaces": ["examples/**"],
  "workspaces": {
    "packages/preact-pacer-devtools": {
      "ignoreDependencies": ["csstype"]
    },
    "packages/react-pacer": {
      "ignore": []
    },
    "packages/react-pacer-devtools": {
      "ignoreDependencies": ["csstype"]
    },
    "packages/solid-pacer-devtools": {
      "ignoreDependencies": ["csstype"]
    },
    ".": {
      "entry": ["tests/e2e/helpers/*.ts"]
    },
    "packages/ember-pacer": {
      "entry": [
        "testem.cjs",
        "tests/test-helper.ts",
        "tests/integration/*.gts"
      ],
      "ignoreDependencies": [
        "@ember/component",
        "@ember/destroyable",
        "@ember/reactive",
        "@ember/runloop",
        "@ember/routing",
        "@embroider/shared-internals",
        "@glint/tsserver-plugin"
      ]
    }
  }
}
